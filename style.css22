@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

:root {
    --bg-dark: #0a0c16;
    --card-glass: rgba(255, 255, 255, 0.04);
    --border-glass: rgba(255, 255, 255, 0.1);
    
    /* درجات الأومبريه المتدرجة */
    --ombre-main: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    --ombre-glow: linear-gradient(135deg, #3b82f6, #8b5cf6, #d946ef);
    --ombre-gold: linear-gradient(135deg, #f59e0b, #ef4444);
    
    --text-light: #ffffff;
    --text-muted: #94a3b8;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Cairo', sans-serif;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    min-height: 100vh;
    padding: 50px 20px;
    display: flex;
    justify-content: center;
    position: relative;
    overflow-x: hidden;
}

/* 🌀 خلفية الأومبريه المحيطية المتوهجة */
body::before,
body::after {
    content: '';
    position: fixed;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
    z-index: -1;
    animation: pulse 8s infinite alternate ease-in-out;
}

body::before {
    background: #6366f1;
    top: -100px;
    right: -100px;
}

body::after {
    background: #ec4899;
    bottom: -100px;
    left: -100px;
}

@keyframes pulse {
    0% { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.2) translate(30px, 40px); }
}

/* 📦 الحاوية العامة */
main {
    width: 100%;
    max-width: 850px;
    display: flex;
    flex-direction: column;
    gap: 30px;
}

/* 💎 الكرت الزجاجي الاحترافي (لأقسامك) */
section {
    background: var(--card-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

section:hover {
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 25px 50px rgba(168, 85, 247, 0.2);
    transform: translateY(-3px);
}

/* 🎨 عناوين الأومبريه المميزة */
h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 12px;
    background: var(--ombre-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 20px;
}

/* 🛠️ تنسيق القوائم والـ divs الداخلية الخاصة بالخبرات والمهارات */
section div {
    transition: all 0.3s ease;
}

/* في حال كانت المهارات مكتوبة داخل divs فرعية */
section > div > div, 
section ul li {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 20px;
    border-radius: 12px;
    margin-bottom: 10px;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

section > div > div:hover,
section ul li:hover {
    background: var(--ombre-glow);
    color: #fff;
    border-color: transparent;
    transform: translateX(-5px);
    box-shadow: 0 10px 20px rgba(139, 92, 246, 0.3);
}

/* 🏆 الأوسمة والإنجازات (أومبريه ذهبي وبنفسجي) */
.badge, .award, [class*="badge"], [class*="award"] {
    background: var(--ombre-gold);
    color: #fff;
    padding: 15px 20px;
    border-radius: 14px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
    display: flex;
    align-items: center;
    gap: 12px;
}

/* 📱 تجاوب الشاشات للجوال */
@media (max-width: 600px) {
    section {
        padding: 20px;
    }
    h2 {
        font-size: 1.3rem;
    }
}